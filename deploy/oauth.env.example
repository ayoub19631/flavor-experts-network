# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn — https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Default if empty: r_liteprofile r_emailaddress (this app rejects openid)
# LINKEDIN_SCOPES=openid profile email
# LINKEDIN_REDIRECT_URI=https://imucfofvdwfyexdwrsfe.supabase.co/functions/v1/oauth?action=callback

# Required for auto-enable of Leaked Password Protection + Auth providers
# Get from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Optional — HMAC for Edge oauth state (auto-generated if empty)
OAUTH_STATE_SECRET=

# Then run:
#   node deploy/enable-auth-security.mjs

