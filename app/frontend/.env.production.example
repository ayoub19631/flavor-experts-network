VITE_SUPABASE_URL=https://imucfofvdwfyexdwrsfe.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

VITE_APP_TITLE=Flavor Experts Network
VITE_APP_DESCRIPTION=A global professional network connecting flavorists, food scientists, R&D professionals, companies, suppliers, and the flavor industry.
VITE_SITE_URL=https://flavorexpertsnetwork.com

# Public beta: site open, payments off
VITE_PLATFORM_PRIVATE=false
VITE_PLATFORM_ACCESS_ALLOWLIST=ayoub@flavorexperts.net,ayobe895@gmail.com
VITE_PAYMENTS_ENABLED=false
VITE_SHOW_TESTING_UI=false
VITE_SUPPORT_EMAIL=
VITE_PRIVACY_EMAIL=
# Official social profiles live in src/lib/social-links.ts.
# Optional https overrides (matching host only). Leave empty to use the official URLs.
# VITE_SOCIAL_INSTAGRAM=
# VITE_SOCIAL_FACEBOOK=
# VITE_SOCIAL_YOUTUBE=
# VITE_SOCIAL_LINKEDIN_PAGE=
# VITE_SOCIAL_LINKEDIN_GROUP=
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_PRIVACY_EMAIL=
# TRANSACTIONAL_FROM_EMAIL is a Supabase Edge Function secret, not a Vite variable.

# Social login (Google only via Edge Function oauth — LinkedIn login is disabled)
VITE_OAUTH_ENABLED=true

# Optional monitoring
# VITE_SENTRY_DSN=

# FlavorBot / OpenAI / Stripe / Resend secrets belong in Supabase Dashboard
# → Project Settings → Edge Functions → Secrets
# NEVER use VITE_OPENAI_API_KEY (would leak the key to every visitor)
