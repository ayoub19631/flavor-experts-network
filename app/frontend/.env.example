# ─── Supabase (required) ─────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── App ──────────────────────────────────────────────────────────────────────
VITE_PORT=3000
VITE_SITE_URL=https://flavorexpertsnetwork.com
VITE_APP_TITLE=Flavor Experts Network
VITE_APP_DESCRIPTION=A global professional network connecting flavorists, food scientists, R&D professionals, companies, suppliers, and the flavor industry.

# Private preview mode — visitors see "Under Development"; only allowlisted users see the site
# VITE_PLATFORM_PRIVATE=true
# Comma-separated emails that can preview while private (VITE_ADMIN_EMAIL is always included)
# VITE_PLATFORM_ACCESS_ALLOWLIST=you@example.com,partner@example.com

# Public contact addresses shown in UI (not secrets). Leave empty to hide mailto links.
# Vite exposes VITE_* . NEXT_PUBLIC_* names are accepted as aliases in Vite config.
# VITE_SUPPORT_EMAIL=
# VITE_PRIVACY_EMAIL=
# NEXT_PUBLIC_SUPPORT_EMAIL=
# NEXT_PUBLIC_PRIVACY_EMAIL=
# VITE_ADMIN_EMAIL=admin@example.com

# Transactional sender is an Edge Function secret only — never VITE_* / NEXT_PUBLIC_*
# TRANSACTIONAL_FROM_EMAIL=Flavor Experts Network <noreply@your-verified-domain>

# Official social profiles live in src/lib/social-links.ts.
# Optional https overrides (matching host only). Leave empty to use the official URLs.
# VITE_SOCIAL_INSTAGRAM=
# VITE_SOCIAL_FACEBOOK=
# VITE_SOCIAL_YOUTUBE=
# VITE_SOCIAL_LINKEDIN_PAGE=
# VITE_SOCIAL_LINKEDIN_GROUP=

# Google sign-in button (default on). LinkedIn login is disabled for now.
VITE_OAUTH_ENABLED=true

# Optional — Sentry error monitoring (DSN is public-by-design; still use project DSN)
# VITE_SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0

# ─── NEVER put these in VITE_* (browser-exposed) ─────────────────────────────
# OPENAI_API_KEY          → Supabase Edge Function secret (flavorbot)
# STRIPE_SECRET_KEY       → Supabase Edge Function secret
# SUPABASE_SERVICE_ROLE   → Edge Functions / server only
# RESEND_API_KEY          → Supabase Edge Function secret (send-email)
# OAUTH_STATE_SECRET      → Supabase Edge Function secret (oauth)
