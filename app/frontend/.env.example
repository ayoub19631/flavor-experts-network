# ─── Supabase (required) ─────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── App ──────────────────────────────────────────────────────────────────────
VITE_PORT=3001
VITE_SITE_URL=https://flavorexpertsnetwork.com
VITE_APP_TITLE=Flavor Experts Network
VITE_APP_DESCRIPTION=The world's largest flavor industry professional community

# Private preview mode — visitors see "Under Development"; only allowlisted users see the site
# VITE_PLATFORM_PRIVATE=true
# Comma-separated emails that can preview while private (VITE_ADMIN_EMAIL is always included)
# VITE_PLATFORM_ACCESS_ALLOWLIST=you@example.com,partner@example.com

# Optional — public admin contact shown in UI (not a secret)
# VITE_ADMIN_EMAIL=admin@flavorexpertsnetwork.com

# Optional — Sentry error monitoring (DSN is public-by-design; still use project DSN)
# VITE_SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0

# ─── NEVER put these in VITE_* (browser-exposed) ─────────────────────────────
# OPENAI_API_KEY          → Supabase Edge Function secret (flavorbot)
# STRIPE_SECRET_KEY       → Supabase Edge Function secret
# SUPABASE_SERVICE_ROLE   → Edge Functions / server only
# RESEND_API_KEY          → Supabase Edge Function secret (send-email)
# OAUTH_STATE_SECRET      → Supabase Edge Function secret (oauth)
